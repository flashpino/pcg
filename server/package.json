{
  "name": "proatus-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.0",
    "@influxdata/influxdb-client": "^1.35.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "pg-boss": "^12.26.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
